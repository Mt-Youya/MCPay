{
  "name": "@mcpay/provider",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "cf:d1:create": "wrangler d1 create mcpay-provider",
    "cf:deploy": "wrangler deploy",
    "cf:check": "pnpm --dir ../.. check:provider",
    "cf:login": "wrangler login",
    "cf:migrate:local": "wrangler d1 migrations apply mcpay-provider --local",
    "cf:migrate": "wrangler d1 migrations apply mcpay-provider --remote",
    "cf:types": "wrangler types worker-configuration.d.ts",
    "predev": "pnpm cf:migrate:local",
    "dev": "wrangler dev",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@mcpay/commerce": "workspace:*",
    "hono": "^4.11.9",
    "viem": "^2.47.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@types/node": "^26.2.0",
    "wrangler": "^4.123.0"
  }
}
