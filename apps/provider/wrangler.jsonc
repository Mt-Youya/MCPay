{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mcpay-research-provider",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "ratelimits": [
    {
      "name": "MCPAY_EXECUTE_RATE_LIMITER",
      "namespace_id": "900001",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mcpay-provider",
      "database_id": "16312b16-eecf-41bf-9b78-e85191a00947",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "MCPAY_PROVIDER_MONAD_RPC_URL": "https://testnet-rpc.monad.xyz/",
    "MCPAY_PROVIDER_MONAD_CHAIN_ID": "10143",
    "MCPAY_PROVIDER_DEEPSEEK_BASE_URL": "https://api.deepseek.com",
    "MCPAY_PROVIDER_DEEPSEEK_MODEL": "deepseek-v4-pro",
  },
  "secrets": {
    "required": [
      "MCPAY_PROVIDER_RECEIVING_ADDRESS",
      "MCPAY_PROVIDER_DEEPSEEK_API_KEY",
      "MCPAY_PROVIDER_TAVILY_API_KEY",
    ],
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 },
  },
}
