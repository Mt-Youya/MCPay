{
  "name": "MCPay",
  "version": "0.0.1",
  "private": true,
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @mcpay/commerce --filter @mcpay/api --filter @mcpay/provider --filter @mcpay/web -r build",
    "dev": "pnpm --filter @mcpay/commerce build && pnpm --parallel --filter @mcpay/api --filter @mcpay/web dev",
    "dev:provider": "pnpm --filter @mcpay/provider dev",
    "check:app": "oxfmt --check apps/api/src apps/web/src packages/commerce/src && oxlint apps/api/src apps/web/src packages/commerce/src",
    "check:provider": "oxfmt --check apps/provider/src packages/commerce/src && oxlint apps/provider/src packages/commerce/src",
    "test": "pnpm --filter @mcpay/commerce --filter @mcpay/api --filter @mcpay/provider --filter @mcpay/web -r test",
    "typecheck": "pnpm --filter @mcpay/commerce --filter @mcpay/api --filter @mcpay/provider --filter @mcpay/web -r typecheck",
    "lint": "oxlint",
    "fmt": "oxfmt --write ."
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "typescript": "^6.0.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
